  background-color: #000016;
  color: #00afff;
  border-color: #00afff;
}

QDialog QPushButton:pressed,
QDialog QPushButton:checked,
QWidget#tabESPs QToolButton:pressed,
QWidget#tabESPs QToolButton:checked {
  background-color: #000016;
  color: #00afff;
  border-color: #00afff;
}

QPushButton#startButton {
  background-color: #10132e;
  color: #00afff;
  border-color: #00afff;
}

QPushButton#startButton:focus {
  background-color: #10132e;
  color: #00afff;
  border-color: #00afff;
}

QPushButton#startButton:hover,
QPushButton#startButton:pressed {
  background-color: #10132e;
  color: #00afff;
  border-color: #00afff;
}


QPushButton:hover,
QToolButton:hover,
QTabBar QToolButton:hover,
QDialog QPushButton:hover,
QWidget#tabESPs QToolButton:hover,
QPushButton#startButton:hover,
QMenuBar::item:hover {
  color: #f7fc00;
  border-color: #f7fc00;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QTextEdit:hover,
QComboBox:hover,
QComboBox:editable:hover,
QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover,
QGroupBox::indicator:hover,
QTreeView::indicator:hover,
QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
  border-color: #f7fc00;
}

QTabBar::tab:hover {
  color: #f7fc00;
  border-color: #f7fc00;
  border-bottom-color: #f7fc00;
